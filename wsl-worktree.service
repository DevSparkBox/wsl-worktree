[Unit]
Description=WSL Worktree Web Manager
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/wangy/.local/share/wsl-worktree
ExecStart=/home/wangy/.nvm/versions/node/v26.6.0/bin/node /home/wangy/.local/share/wsl-worktree/server.mjs
Restart=always
RestartSec=2
StandardOutput=append:/home/wangy/.local/share/wsl-worktree/server.log
StandardError=append:/home/wangy/.local/share/wsl-worktree/server.log

[Install]
WantedBy=default.target
